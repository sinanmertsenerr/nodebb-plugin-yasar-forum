{
	"id": "nodebb-plugin-yasar-forum",
	"name": "Yaşar Forum",
	"description": "The site's custom CSS and JavaScript served as cached static files",
	"url": "https://github.com/sinanmertsenerr/nodebb-plugin-yasar-forum",
	"library": "./library.js",
	"hooks": [
		{ "hook": "filter:meta.getLinkTags", "method": "addStylesheet" },
		{ "hook": "filter:scripts.get", "method": "addScript" },
		{ "hook": "filter:middleware.renderHeader", "method": "sidebarState" },
		{ "hook": "filter:middleware.renderFooter", "method": "sidebarState" },
		{ "hook": "filter:timetable.build", "method": "gateTools" },
		{ "hook": "filter:cv.build", "method": "gateTools" },
		{ "hook": "filter:pdf.build", "method": "gateTools" },
		{ "hook": "filter:widget.render:html", "method": "hideToolWidgets", "priority": 20 }
	],
	"templates": "templates",
	"staticDirs": {
		"static": "./static"
	}
}
